{
  "name": "@junocash-tools/exchange-sdk",
  "version": "0.1.0",
  "description": "Typed Node.js client for Juno exchange transaction coordination and gateway APIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junocash-tools/juno-exchange-sdk.git"
  },
  "homepage": "https://junocash-tools.github.io/juno-exchange-gateway/transactions/automation/",
  "bugs": {
    "url": "https://github.com/junocash-tools/juno-exchange-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/write-cjs-package.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:pack": "node scripts/consumer-smoke.mjs",
    "test": "npm run build && npm run test:unit && npm run test:pack",
    "check": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
